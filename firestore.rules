rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sales/{document=**} {
      allow read, write: if true;
    }
    match /sales_archive/{document=**} {
      allow read, write: if true;
    }
    match /incidents/{document=**} {
      allow read, write: if true;
    }
    match /coupons/{document=**} {
      allow read, write: if true;
    }
    match /stock/{document=**} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
