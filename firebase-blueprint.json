{
  "entities": {
    "Sale": {
      "title": "Sale",
      "description": "Definition of a sale document in Firestore",
      "type": "object",
      "properties": {
        "numeroVenta": { "type": "number" },
        "fecha": { "type": "string" },
        "cliente": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Pendiente", "Enviado"] },
        "enviado": { "type": "boolean" },
        "datosCompletos": { "type": "boolean" }
      },
      "required": ["numeroVenta", "fecha", "cliente", "total", "status"]
    },
    "StockItem": {
      "title": "StockItem",
      "description": "Definition of a stock item",
      "type": "object",
      "properties": {
        "codigo": { "type": "string" },
        "stockActual": { "type": "number" }
      },
      "required": ["codigo", "stockActual"]
    },
    "Incident": {
      "title": "Incident",
      "description": "Definition of a post-venta incident or case",
      "type": "object",
      "properties": {
        "codigoCaso": { "type": "string" },
        "cliente": { "type": "string" },
        "telefono": { "type": "string" },
        "canal": { "type": "string" },
        "motivo": { "type": "string" },
        "prioridad": { "type": "string" },
        "estado": { "type": "string" },
        "responsable": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["codigoCaso", "cliente", "telefono", "canal", "motivo", "prioridad", "estado", "responsable", "createdAt", "updatedAt"]
    },
    "UsaPurchase": {
      "title": "UsaPurchase",
      "description": "Direct USA container imports and supplier statement in USD with CLP reference notes",
      "type": "object",
      "properties": {
        "proveedor": { "type": "string" },
        "montoTotalUsd": { "type": "number" },
        "saldoPendienteUsd": { "type": "number" },
        "estado": { "type": "string" }
      },
      "required": ["proveedor", "montoTotalUsd", "saldoPendienteUsd", "estado"]
    },
    "SaleReturn": {
      "title": "SaleReturn",
      "description": "Customer sales returns with optional commission deduction and warehouse restock",
      "type": "object",
      "properties": {
        "codigoDevolucion": { "type": "string" },
        "fecha": { "type": "string" },
        "cliente": { "type": "string" },
        "vendedor": { "type": "string" },
        "agencia": { "type": "string" },
        "producto": { "type": "string" },
        "motivo": { "type": "string" },
        "costo": { "type": "number" },
        "aplicaDescuentoComision": { "type": "boolean" },
        "montoDescuentoComision": { "type": "number" }
      },
      "required": ["codigoDevolucion", "fecha", "cliente", "vendedor", "producto", "motivo"]
    },
    "ValeEntrada": {
      "title": "ValeEntrada",
      "description": "Inbound cargo and container receipt voucher with multiple items, optional container ID and mandatory responsible staff",
      "type": "object",
      "properties": {
        "folio": { "type": "string" },
        "fecha": { "type": "string" },
        "responsable": { "type": "string" },
        "numeroContenedor": { "type": "string" },
        "totalArticulos": { "type": "number" },
        "totalUnidades": { "type": "number" }
      },
      "required": ["folio", "fecha", "responsable", "totalArticulos", "totalUnidades"]
    },
    "LabelPrintLog": {
      "title": "LabelPrintLog",
      "description": "Log of thermal label prints with multi-product delivery tracking and reprint audit",
      "type": "object",
      "properties": {
        "saleId": { "type": "string" },
        "numeroVenta": { "type": "number" },
        "cliente": { "type": "string" },
        "impresoPor": { "type": "string" },
        "cantidadEtiquetas": { "type": "number" },
        "modoImpresion": { "type": "string" },
        "fechaHora": { "type": "string" },
        "esReimpresion": { "type": "boolean" },
        "numeroImpresion": { "type": "number" }
      },
      "required": ["saleId", "numeroVenta", "cliente", "impresoPor", "cantidadEtiquetas", "modoImpresion", "fechaHora"]
    },
    "DeletedSale": {
      "title": "DeletedSale",
      "description": "Retired sales audit record to permanently reserve sale numbers and avoid confusion in bodega",
      "type": "object",
      "properties": {
        "numeroVenta": { "type": "number" },
        "cliente": { "type": "string" },
        "vendedor": { "type": "string" },
        "fechaVenta": { "type": "string" },
        "total": { "type": "number" },
        "deletedAt": { "type": "string" },
        "deletedBy": { "type": "string" },
        "motivo": { "type": "string" }
      },
      "required": ["numeroVenta", "cliente", "vendedor", "deletedAt", "deletedBy"]
    }
  },
  "firestore": {
    "/label_prints/{printId}": {
      "schema": { "$ref": "LabelPrintLog" },
      "description": "Thermal label printing history and multi-product delivery logs"
    },
    "/deleted_sales/{saleId}": {
      "schema": { "$ref": "DeletedSale" },
      "description": "Permanently retired sales and audit trail to prevent reuse of numbers"
    },
    "/vales_entrada/{valeId}": {
      "schema": { "$ref": "ValeEntrada" },
      "description": "Inbound shipment and container receipt vouchers"
    },
    "/devoluciones/{returnId}": {
      "schema": { "$ref": "SaleReturn" },
      "description": "Sales returns and commission deductions"
    },
    "/sales/{saleId}": {
      "schema": { "$ref": "Sale" },
      "description": "Sales collection"
    },
    "/sales_archive/{saleId}": {
      "schema": { "$ref": "Sale" },
      "description": "Historical archived sales repository collection"
    },
    "/stock/{itemId}": {
      "schema": { "$ref": "StockItem" },
      "description": "Stock collection"
    },
    "/incidents/{incidentId}": {
      "schema": { "$ref": "Incident" },
      "description": "Post-venta incidents collection"
    },
    "/purchases/{purchaseId}": {
      "description": "Domestic purchases in CLP"
    },
    "/usa_purchases/{purchaseId}": {
      "schema": { "$ref": "UsaPurchase" },
      "description": "USA container purchases and statement in USD"
    },
    "/salary_advances/{advanceId}": {
      "description": "Employee salary advances deducted on Saturday payments"
    },
    "/employee_loans/{loanId}": {
      "description": "Employee loans with multi-week installments"
    },
    "/work_extras/{extraId}": {
      "description": "Extra loading, unloading and bonus works"
    },
    "/payroll_records/{recordId}": {
      "description": "Weekly payroll settlement records and receipts"
    }
  }
}
